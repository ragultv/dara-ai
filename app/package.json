{
  "name": "dara-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "node ./tools/copy-tokens.js",
    "dev": "npm run prebuild && vite",
    "build": "npm run prebuild && vite build",
    "preview": "vite preview",
    "check": "npm run prebuild && svelte-check --tsconfig ./tsconfig.json",
    "lint": "npm run prebuild && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run prebuild && vitest run",
    "test:watch": "vitest",
    "e2e": "npm run prebuild && playwright test",
    "tauri": "node tools/run-tauri.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.9",
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/svelte": "^5.2.7",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.1",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
